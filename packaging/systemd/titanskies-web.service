[Unit]
Description=TitanSkies local web application
After=network.target

[Service]
Type=simple
WorkingDirectory=@CURRENT@
EnvironmentFile=@ENV@
ExecStart=/usr/bin/env node scripts/run-web.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@STATE@

[Install]
WantedBy=default.target
