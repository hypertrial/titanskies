[Unit]
Description=Refresh TitanSkies government data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@CURRENT@
EnvironmentFile=@ENV@
ExecStart=@CURRENT@/.venv/bin/python scripts/watch_context.py --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE@ @CACHE@
