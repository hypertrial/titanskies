#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

fail() { printf '%s\n' "$*" >&2; exit 1; }

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) ;;
  *) fail "macOS release builds require a Darwin arm64 host" ;;
esac

for tool in xcode-select xcodebuild xcrun swift codesign spctl hdiutil ditto shasum; do
  command -v "$tool" >/dev/null 2>&1 || fail "$tool is required"
done

DEVELOPER_DIR_PATH=$(xcode-select -p 2>/dev/null || true)
case "$DEVELOPER_DIR_PATH" in
  *Xcode*.app/Contents/Developer) ;;
  *) fail "select a full Xcode with: sudo xcode-select --switch /Applications/Xcode.app/Contents/Developer" ;;
esac
xcodebuild -version >/dev/null
xcrun --find notarytool >/dev/null
xcrun --find stapler >/dev/null

WORK=$(mktemp -d /tmp/titanskies-xcode-preflight.XXXXXX)
trap 'rm -rf "$WORK"' EXIT
printf 'import Foundation\nlet value = 1\n' > "$WORK/preflight.swift"
xcrun --sdk macosx swiftc -target arm64-apple-macos13.0 -typecheck "$WORK/preflight.swift" \
  || fail "the selected Swift compiler does not match the selected macOS SDK"

if [ "${1:-}" != "--build-only" ]; then
  [ -n "${MACOS_DEVELOPER_ID_IDENTITY:-}" ] || fail "MACOS_DEVELOPER_ID_IDENTITY is required"
  [ -n "${MACOS_TEAM_ID:-}" ] || fail "MACOS_TEAM_ID is required"
  [ -n "${MACOS_NOTARY_PROFILE:-}" ] || fail "MACOS_NOTARY_PROFILE is required"
  [ -r "${MACOS_UPDATE_PRIVATE_KEY:-}" ] || fail "MACOS_UPDATE_PRIVATE_KEY must name a readable Ed25519 private key"
  security find-identity -v -p codesigning | grep -F "$MACOS_DEVELOPER_ID_IDENTITY" >/dev/null \
    || fail "the Developer ID identity is not available in the keychain"
  xcrun notarytool history --keychain-profile "$MACOS_NOTARY_PROFILE" --output-format json >/dev/null \
    || fail "the notarization keychain profile is unavailable"
fi

printf 'macOS release preflight passed\n'
