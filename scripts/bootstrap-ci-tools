#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

npm ci
uv sync --frozen --all-extras

if ! command -v gitleaks >/dev/null 2>&1; then
  version=8.30.1
  case "$(uname -s):$(uname -m)" in
    Linux:x86_64)
      archive_name="gitleaks_${version}_linux_x64.tar.gz"
      checksum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
      ;;
    Linux:aarch64|Linux:arm64)
      archive_name="gitleaks_${version}_linux_arm64.tar.gz"
      checksum=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
      ;;
    Darwin:arm64)
      archive_name="gitleaks_${version}_darwin_arm64.tar.gz"
      checksum=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
      ;;
    Darwin:x86_64)
      archive_name="gitleaks_${version}_darwin_x64.tar.gz"
      checksum=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709
      ;;
    *)
      echo "Unsupported Gitleaks bootstrap platform: $(uname -s)/$(uname -m)" >&2
      exit 1
      ;;
  esac

  tools_dir="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/titanskies-tools"
  archive="$tools_dir/$archive_name"
  mkdir -p "$tools_dir"
  curl --fail --location --silent --show-error \
    "https://github.com/gitleaks/gitleaks/releases/download/v$version/$archive_name" \
    --output "$archive"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check -
  else
    printf '%s  %s\n' "$checksum" "$archive" | shasum -a 256 --check -
  fi
  tar -xzf "$archive" -C "$tools_dir" gitleaks
  chmod +x "$tools_dir/gitleaks"
  [ -n "${GITHUB_PATH:-}" ] || { echo "GITHUB_PATH is required to install Gitleaks" >&2; exit 1; }
  printf '%s\n' "$tools_dir" >> "$GITHUB_PATH"
fi

if [ "$(uname -s)" = Linux ]; then
  npx playwright install --with-deps chromium webkit
else
  npx playwright install chromium webkit
fi

docker info >/dev/null
