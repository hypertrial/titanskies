#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
ROOT=$(pwd)
STAGE="${TITANSKIES_MACOS_RUNTIME_STAGE:-$ROOT/.local/macos-runtime}"
OUT="${TITANSKIES_MACOS_APP:-$ROOT/dist/macos/TitanSkies.app}"
SWIFT_ROOT="$ROOT/macos/TitanSkies"
VERSION=$(python3 -c "import json; print(json.load(open('package.json'))['version'])")
CHANNEL=${TITANSKIES_MACOS_CHANNEL:-unsigned-beta}
BUILD_NUMBER=${MACOS_BUILD_NUMBER:-1}
SOURCE_REVISION=$(git rev-parse HEAD)

fail() { printf '%s\n' "$*" >&2; exit 1; }
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) ;;
  *) fail "build-macos-app requires a Darwin arm64 host" ;;
esac
[ -x "$STAGE/node/bin/node" ] || fail "run scripts/build-macos-runtime first"
command -v swift >/dev/null || fail "swift is required"
case "$CHANNEL" in
  unsigned-beta) ;;
  production)
    [ -n "${MACOS_BUILD_NUMBER:-}" ] || fail "MACOS_BUILD_NUMBER is required for production builds"
    [ -z "$(git status --porcelain --untracked-files=all)" ] || fail "production builds require a clean source tree"
    ./scripts/macos-release-preflight --build-only
    ;;
  *) fail "TITANSKIES_MACOS_CHANNEL must be unsigned-beta or production" ;;
esac
case "$BUILD_NUMBER" in
  ''|*[!0-9]*|0) fail "MACOS_BUILD_NUMBER must be a positive integer" ;;
esac

mkdir -p "$SWIFT_ROOT/.build-icon/AppIcon.iconset"
SRC="$ROOT/app/icon.png"
for size in 16 32 64 128 256 512; do
  sips -z "$size" "$size" "$SRC" --out "$SWIFT_ROOT/.build-icon/AppIcon.iconset/icon_${size}x${size}.png" >/dev/null
  double=$((size * 2))
  if [ "$size" -lt 512 ]; then
    sips -z "$double" "$double" "$SRC" --out "$SWIFT_ROOT/.build-icon/AppIcon.iconset/icon_${size}x${size}@2x.png" >/dev/null
  else
    sips -z 1024 1024 "$SRC" --out "$SWIFT_ROOT/.build-icon/AppIcon.iconset/icon_512x512@2x.png" >/dev/null
  fi
done
iconutil -c icns "$SWIFT_ROOT/.build-icon/AppIcon.iconset" -o "$SWIFT_ROOT/.build-icon/AppIcon.icns"

(
  cd "$SWIFT_ROOT"
  swift build -c release --arch arm64
)
BIN="$SWIFT_ROOT/.build/arm64-apple-macosx/release"
if [ ! -x "$BIN/TitanSkies" ]; then
  BIN="$SWIFT_ROOT/.build/out/Products/Release"
fi
[ -x "$BIN/TitanSkies" ] || fail "TitanSkies binary missing"

rm -rf "$OUT"
mkdir -p "$OUT/Contents/MacOS" "$OUT/Contents/Resources/Host" "$OUT/Contents/Resources" "$OUT/Contents/Library/LaunchAgents"
cp "$BIN/TitanSkies" "$OUT/Contents/MacOS/TitanSkies"
cp "$BIN/TitanSkiesWeb" "$OUT/Contents/MacOS/TitanSkiesWeb"
cp "$BIN/TitanSkiesIngest" "$OUT/Contents/MacOS/TitanSkiesIngest"
cp "$BIN/TitanSkiesUpdater" "$OUT/Contents/MacOS/TitanSkiesUpdater"
cp packaging/macos/Info.plist "$OUT/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $VERSION" "$OUT/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $BUILD_NUMBER" "$OUT/Contents/Info.plist"
cp "$SWIFT_ROOT/.build-icon/AppIcon.icns" "$OUT/Contents/Resources/AppIcon.icns"
cp packaging/macos/runtime-lock.json "$OUT/Contents/Resources/runtime-lock.json"
python3 - "$OUT/Contents/Resources/runtime-lock.json" "$CHANNEL" "$VERSION" "$BUILD_NUMBER" "$SOURCE_REVISION" <<'PY'
import json, sys
from pathlib import Path

path = Path(sys.argv[1])
payload = json.loads(path.read_text(encoding="utf-8"))
payload["channel"] = sys.argv[2]
payload["appVersion"] = sys.argv[3]
payload["buildNumber"] = int(sys.argv[4])
payload["sourceRevision"] = sys.argv[5]
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY
if [ "$CHANNEL" = unsigned-beta ]; then
  cp packaging/macos/UNSIGNED-BETA.txt "$OUT/Contents/Resources/UNSIGNED-BETA.txt"
fi
cp packaging/macos/update-public-key.json "$OUT/Contents/Resources/update-public-key.json"
cp packaging/macos/launchd/com.hypertrial.titanskies.web.plist "$OUT/Contents/Library/LaunchAgents/"
cp packaging/macos/launchd/com.hypertrial.titanskies.ingest.plist "$OUT/Contents/Library/LaunchAgents/"
rm -rf "$OUT/Contents/Resources/Host/node" "$OUT/Contents/Resources/Host/python" "$OUT/Contents/Resources/Runtime"
cp -R "$STAGE/node" "$OUT/Contents/Resources/Host/node"
cp -R "$STAGE/python" "$OUT/Contents/Resources/Host/python"
cp -R "$STAGE/runtime" "$OUT/Contents/Resources/Runtime"
find "$OUT/Contents/Resources/Runtime/scripts" -type f ! \( -name 'run-web.mjs' -o -name 'watch_context.py' -o -name 'generate_demo.py' \) -delete
cp THIRD_PARTY_NOTICES.md "$OUT/Contents/Resources/THIRD_PARTY_NOTICES.md"
cp LICENSE "$OUT/Contents/Resources/LICENSE"

rm -rf "$OUT/Contents/Resources/Host/python/include" "$OUT/Contents/Resources/Host/python/share" \
  "$OUT/Contents/Resources/Host/python/lib/pkgconfig" "$OUT/Contents/Resources/Host/node/include" \
  "$OUT/Contents/Resources/Host/node/share" "$OUT/Contents/Resources/Host/node/lib"
find "$OUT/Contents/Resources/Host/python/bin" -mindepth 1 ! -name python3 ! -name python3.12 -delete
find "$OUT/Contents/Resources/Host/python/lib" -maxdepth 1 \( \
  -name 'libtcl*' -o -name 'libtk*' -o -name 'itcl*' -o -name 'tdbc*' \
  -o -name 'tcl*' -o -name 'tk*' -o -name 'thread*' -o -name 'pkgconfig' \
\) -exec rm -rf {} +
rm -f "$OUT/Contents/Resources/Host/python/lib/python3.12/lib-dynload/"_tkinter*.so
find "$OUT/Contents/Resources/Host/node/bin" -mindepth 1 ! -name node -delete
# Sign nested Mach-O files inside-out. Do not use codesign --deep for signing.
python3 - "$OUT" packaging/macos/entitlements-beta.plist <<'PY'
import subprocess, sys
from pathlib import Path
app = Path(sys.argv[1])
entitlements = sys.argv[2]

def macho_files(root: Path) -> list[Path]:
    files = []
    if not root.exists():
        return files
    for path in root.rglob("*"):
        if not path.is_file():
            continue
        kind = subprocess.run(["file", "-b", str(path)], capture_output=True, text=True).stdout
        if "Mach-O" in kind:
            files.append(path)
    return sorted(files, reverse=True)

for root in (
    app / "Contents/Resources",
    app / "Contents/Resources/Host",
    app / "Contents/MacOS",
):
    for path in macho_files(root):
        if path.parent.name == "MacOS" and path.name == "TitanSkies":
            continue
        subprocess.check_call(["codesign", "--force", "--sign", "-", "--timestamp=none", str(path)])
subprocess.check_call([
    "codesign", "--force", "--sign", "-", "--timestamp=none",
    "--entitlements", entitlements, str(app),
])
PY
codesign --verify --strict "$OUT"
printf 'assembled %s\n' "$OUT"
