#!/bin/sh
set -eu

[ "$#" -eq 3 ] || { echo "usage: update-user RELEASE.tar.gz SHA256SUMS SHA256SUMS.sig" >&2; exit 2; }
absolute_path() { directory=$(CDPATH='' cd -- "$(dirname -- "$1")" && pwd); printf '%s/%s\n' "$directory" "$(basename -- "$1")"; }
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
archive=$(absolute_path "$1")
checksums=$(absolute_path "$2")
signature=$(absolute_path "$3")
public_key=$root/packaging/release-cosign.pub
command -v cosign >/dev/null 2>&1 || { echo "cosign is required to verify the release signature" >&2; exit 1; }
[ -f "$public_key" ] || { echo "embedded release public key is missing" >&2; exit 1; }
[ -f "$archive" ] && [ -f "$checksums" ] && [ -f "$signature" ] || { echo "release inputs must be regular files" >&2; exit 1; }
cosign verify-blob --key "$public_key" --signature "$signature" "$checksums"
archive_name=$(basename -- "$archive")
expected_digest=$(awk -v target="$archive_name" '
  $2 == target { digest = $1; matches += 1 }
  END { if (matches != 1) exit 1; print digest }
' "$checksums") || { echo "release archive has no unique checksum entry" >&2; exit 1; }
actual_digest=$(sha256sum "$archive" | awk '{print $1}')
[ "$actual_digest" = "$expected_digest" ] || { echo "release archive checksum mismatch" >&2; exit 1; }
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
tar -xzf "$archive" -C "$temporary"
installer=$(find "$temporary" -path '*/scripts/install-user' -type f -print -quit)
[ -n "$installer" ] || { echo "release archive has no installer" >&2; exit 1; }
"$installer"
