#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

fail() { printf '%s\n' "$*" >&2; exit 1; }

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) ;;
  *)
    printf 'macos-host-smoke skipped: Darwin arm64 required (current %s-%s)\n' "$(uname -s)" "$(uname -m)"
    exit 0
    ;;
esac

./scripts/run_python.sh - <<'PY'
from pathlib import Path
from macos.packaging_lib import BUNDLE_ID, is_untrusted_install_source

assert is_untrusted_install_source(Path("/Volumes/TitanSkies/TitanSkies.app"))
assert is_untrusted_install_source(Path("/private/var/folders/zz/AppTranslocation/TitanSkies.app"))
assert not is_untrusted_install_source(Path.home() / "Applications/TitanSkies.app")
print(f"bundle-id {BUNDLE_ID}")
PY

if [ -d dist/macos/TitanSkies.app ]; then
  codesign --verify --strict dist/macos/TitanSkies.app
  PYTHONDONTWRITEBYTECODE=1 PATH="/usr/bin:/bin" dist/macos/TitanSkies.app/Contents/Resources/Host/node/bin/node -e "process.exit(process.version.startsWith('v22')?0:1)"
  PYTHONDONTWRITEBYTECODE=1 PATH="/usr/bin:/bin" dist/macos/TitanSkies.app/Contents/Resources/Host/python/bin/python3 -c "import eccodes, numpy, PIL, tifffile; print('bundled-python-ok')"
  if [ -f "$HOME/Library/LaunchAgents/com.hypertrial.titanskies.beta.web.plist" ]; then
    grep -q 'dist/macos' "$HOME/Library/LaunchAgents/com.hypertrial.titanskies.beta.web.plist" && fail "LaunchAgent points at dist/macos"
  fi
fi

if [ -f dist/macos/TitanSkies-0.1.0-macos-arm64.dmg ]; then
  mount="$(mktemp -d /tmp/titanskies-dmg-XXXX)"
  hdiutil attach -readonly -nobrowse -mountpoint "$mount" dist/macos/TitanSkies-0.1.0-macos-arm64.dmg
  trap 'hdiutil detach "$mount" -force >/dev/null 2>&1 || true' EXIT
  [ -d "$mount/TitanSkies.app" ] || fail "DMG is missing TitanSkies.app"
  /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$mount/TitanSkies.app/Contents/Info.plist" | grep -qx 'com.hypertrial.titanskies' || fail "DMG bundle id mismatch"
  case "$(hdiutil info)" in
    *"$mount"*) ;;
    *) fail "DMG did not stay mounted read-only" ;;
  esac
  hdiutil detach "$mount" -force
  trap - EXIT
fi

if [ -d "$HOME/Applications/TitanSkies.app" ]; then
  launchctl print "gui/$(id -u)/com.hypertrial.titanskies.beta.web" >/tmp/titanskies-web-agent.txt 2>/dev/null || true
  launchctl print "gui/$(id -u)/com.hypertrial.titanskies.beta.ingest" >/tmp/titanskies-ingest-agent.txt 2>/dev/null || true
fi

printf 'macos-host-smoke passed\n'
