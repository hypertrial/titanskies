# Installed deployments use live government sources. Set demo for network-free use.
CONTEXT_SOURCE=live

# Storage adapter. Docker uses local storage. Vercel production sets
# this to blob and supplies all three Blob values as server-only variables.
STORAGE_BACKEND=local
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# PUBLIC_BLOB_BASE_URL=
# CRON_SECRET=

# Local publication and reusable numeric/model cache.
TITANSKIES_DATA_DIR=.local/data
TITANSKIES_CACHE_DIR=.local/cache
# Safe local listener defaults.
TITANSKIES_BIND_ADDR=127.0.0.1
TITANSKIES_PORT=8080

# Re-ingest interval in seconds, clamped to 60–3600. Default: 900.
CONTEXT_WATCH_SECONDS=900
# Ingest lock lease in seconds, clamped to 60–420. Default: 420.
INGEST_LOCK_SECONDS=420
FRAME_RETENTION_HOURS=48
# Delete orphaned context assets after a successful live publish. Default: true.
CONTEXT_ORPHAN_GC_ENABLED=true

# Optional. AirNow is unavailable without it; all other sources still run.
AIRNOW_API_KEY=

# Performance controls. Defaults are appropriate for a 1 GiB host.
INGEST_BUDGET_SECONDS=300
INGEST_HTTP_CONCURRENCY=12
CONTEXT_SOURCE_CONCURRENCY=3
# Fetch NOAA HRRR smoke when live. Default: true.
HRRR_SMOKE_ENABLED=true
HRRR_CONCURRENCY=4
FIREWORK_CONCURRENCY=6
# Fetch INECC/SINAICA stations when live. Default: true.
SINAICA_ENABLED=true
SINAICA_CONCURRENCY=4
# Minimum accepted SINAICA stations, clamped to 1–500. Default: 8.
SINAICA_MIN_STATIONS=8
# Fail SINAICA when the stale-station fraction exceeds this rate. Default: 0.85.
SINAICA_STALE_RATE=0.85

# Source endpoint overrides are test-only and intentionally omitted here.
